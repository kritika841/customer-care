# Database and Supabase authentication
SUPABASE_DB_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required in production (32+ random characters, e.g. `openssl rand -base64 32`)
SESSION_SECRET=
# Canonical public origin for OAuth redirects and customer CSAT links
NEXT_PUBLIC_APP_URL=http://127.0.0.1:5010

# Shopify — configure only with rotated credentials in the deployment secret store.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHANNEL_NAME=Shopify_5
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_WEBHOOK_SECRET=
CRON_SECRET=

# Customer support — Google Workspace / Gmail
SUPPORT_MAILBOX=kritika@satmi.in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5010/api/support/gmail/callback
# Base64-encoded 32-byte key. Keep stable after connecting a mailbox.
SUPPORT_TOKEN_KEY=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_SERVICE_ACCOUNT=
GMAIL_PUSH_AUDIENCE=

# Customer support — Meta (Facebook Messenger & Instagram Direct)
META_SYSTEM_USER_TOKEN=
META_PAGE_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Customer support — Autonomous AI Agent (Claude Haiku 5.5 + Strict Spend Guardrails) & Hybrid Store RAG Embeddings (Gemini)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_STRICT_HAIKU=true
ANTHROPIC_ALLOW_LEGACY_HAIKU=false
ANTHROPIC_MAX_OUTPUT_TOKENS=1200
AI_SPEND_GUARD_ENABLED=true
AI_MAX_DAILY_USD=1.00
AI_MAX_MONTHLY_USD=15.00
AI_MAX_REQUESTS_PER_HOUR=120
AI_MAX_CALLS_PER_TICKET_24H=6

# Embeddings (Anthropic has no embedding model; Gemini handles 768-dim vector embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Keep false to enforce Draft/Sandbox Safe Mode (zero real customers messaged by AI)
AI_LIVE_OUTBOUND_ENABLED=false
